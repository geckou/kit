{
  "name": "@geckou/firebase-client",
  "version": "0.3.0",
  "description": "Firebase client SDK wrappers (app init / Firestore CRUD / Storage) for web and React Native",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./firestore": {
      "import": {
        "types": "./dist/esm/firestore.d.ts",
        "default": "./dist/esm/firestore.js"
      },
      "require": {
        "types": "./dist/firestore.d.ts",
        "default": "./dist/firestore.js"
      },
      "default": {
        "types": "./dist/firestore.d.ts",
        "default": "./dist/firestore.js"
      }
    },
    "./storage": {
      "import": {
        "types": "./dist/esm/storage.d.ts",
        "default": "./dist/esm/storage.js"
      },
      "require": {
        "types": "./dist/storage.d.ts",
        "default": "./dist/storage.js"
      },
      "default": {
        "types": "./dist/storage.d.ts",
        "default": "./dist/storage.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geckou/kit.git",
    "directory": "packages/firebase-client"
  },
  "author": "geckou-shogo <shogo.nojima@geckou.net>",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.esm.json && bash ../../scripts/emit-esm-package-json.sh dist/esm",
    "type-check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "peerDependencies": {
    "firebase": ">=11.0.0"
  },
  "devDependencies": {
    "@geckou/eslint-config": "^0.3.0",
    "firebase": "^11.0.0"
  },
  "typesVersions": {
    "*": {
      "firestore": [
        "dist/firestore.d.ts"
      ],
      "storage": [
        "dist/storage.d.ts"
      ]
    }
  }
}

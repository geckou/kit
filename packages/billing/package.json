{
  "name": "@geckou/billing",
  "version": "0.3.0",
  "description": "Subscription entitlement and webhook handling (Stripe / RevenueCat) for Firebase-based projects",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./entitlement": {
      "types": "./dist/entitlement.d.ts",
      "default": "./dist/entitlement.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geckou/kit.git",
    "directory": "packages/billing"
  },
  "author": "geckou-shogo <shogo.nojima@geckou.net>",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "peerDependencies": {
    "firebase-admin": ">=12.0.0",
    "stripe": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "stripe": {
      "optional": true
    }
  },
  "devDependencies": {
    "@geckou/eslint-config": "^0.3.0",
    "firebase-admin": "^13.0.0",
    "stripe": "^18.0.0"
  },
  "typesVersions": {
    "*": {
      "entitlement": [
        "dist/entitlement.d.ts"
      ]
    }
  }
}

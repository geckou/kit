{
  "name": "@geckou/kit-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Geckou Kit — shared server/client packages for Firebase-based projects",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geckou/kit.git"
  },
  "author": "geckou-shogo <shogo.nojima@geckou.net>",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "yarn workspaces run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "yarn workspaces run lint",
    "lint:fix": "yarn workspaces run lint:fix",
    "prepare": "husky",
    "release": "bash scripts/release.sh",
    "test": "yarn workspaces run test",
    "type-check": "yarn workspaces run type-check"
  },
  "devDependencies": {
    "@commitlint/cli": "^21",
    "@geckou/commitlint-config": "^0.1.1",
    "@geckou/eslint-config": "^0.1.1",
    "@geckou/prettier-config": "^0.1.1",
    "@types/node": "^22.20.1",
    "eslint": "^9",
    "husky": "^9",
    "prettier": "^3",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  }
}
